<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Цвета -->
    <!-- Кисти Windows 7 Aero -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F0F0"/>
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E5F0FF" Offset="0"/>
        <GradientStop Color="#C9E0FF" Offset="0.5"/>
        <GradientStop Color="#A0C4FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#8FA0B0"/>
    <SolidColorBrush x:Key="ButtonNormalBrush" Color="#d6e1f3"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#B0D0F0"/>
    <SolidColorBrush x:Key="ButtonCloseHoverBrush" Color="#E81123"/>
    <SolidColorBrush x:Key="ButtonPressBrush" Color="#A0B0C0"/>

    <Style x:Key="ModernWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="#2C3E50"/>
        <Setter Property="FontFamily" Value="Segoe UI, 'Segoe UI Light', Roboto, sans-serif"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="{StaticResource WindowBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
    </Style>

    <!--Стиль для звёздочки * -->
    <Style x:Key="RequiredStyle" TargetType="Label">
        <Setter Property="Foreground" Value="Red"></Setter>
        <Setter Property="Control.Margin" Value="0"></Setter>
        <Setter Property="Control.Padding" Value="0"></Setter>
        <Setter Property="Control.MinWidth" Value="0"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Right"></Setter>
    </Style>

    <Style x:Key="TytletStyle" TargetType="Label">
        <Setter Property="Grid.Column" Value="0"></Setter>
        <Setter Property="Grid.Row" Value="0"></Setter>
        <Setter Property="Grid.ColumnSpan" Value="3"></Setter>

        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="FontWeight" Value="Bold"></Setter>
        
        <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Right"></Setter>
    </Style>

    <!--Стиль для первого столбца при вводе данных -->
    <Style x:Key="InputInfoStyle" TargetType="Label">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Right"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Right"></Setter>
        <Setter Property="Control.Margin" Value="20 1 20 5"></Setter>
    </Style>

    <Style x:Key="InputTextBoxStyle" TargetType="TextBox" >
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="Control.Margin" Value="5 1 15 5"></Setter>
        <Setter Property="Control.Padding" Value="12"></Setter>
    </Style>

    <Style x:Key="InputComboBoxStyle" TargetType="ComboBox" >
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="Control.Margin" Value="5 1 15 5"></Setter>
        <Setter Property="Control.Padding" Value="12"></Setter>
    </Style>

    <Style x:Key="InputDatePickerStyle" TargetType="DatePicker" >
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        <Setter Property="Control.Margin" Value="5 1 15 5"></Setter>
        <Setter Property="Control.Padding" Value="12"></Setter>

        <Setter Property="Control.MaxWidth" Value="400"></Setter>
        <Setter Property="Control.MinWidth" Value="200"></Setter>
    </Style>

    <!-- Стиль кнопок управления окном -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="10 5 10 5"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Background" Value="{StaticResource ButtonNormalBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
        
        
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonPressBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#e6edf7"/>
                <Setter Property="Foreground" Value="#808080"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль кнопки закрытия (красное наведение) -->
    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ButtonCloseHoverBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль StatusBar -->
    <Style x:Key="StatusBarStyle" TargetType="StatusBar">
        <Setter Property="Padding" Value="5"></Setter>
        <Setter Property="Background" Value="AliceBlue"></Setter>
        <Setter Property="Grid.ColumnSpan" Value="3"></Setter>
    </Style>


</ResourceDictionary>




















