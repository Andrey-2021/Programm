<Window x:Class="Crm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crm"
        mc:Ignorable="d"
        Title="Медицинская информационная система MedSoft"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BooleanToCollapsedVisibilityConverter x:Key="BTVConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Menu x:Name="myMenu" DockPanel.Dock="Top" Background="Beige" Padding="5">

            <MenuItem Header="Администратор"
                      IsEnabled="{Binding IsAdmin}" Visibility="{Binding IsAdmin, Converter={StaticResource BTVConverter}}">
                <MenuItem Header="Создать новую БД" Command="{Binding CreateDbCommand}"></MenuItem>
                <MenuItem Header="Загрузить данные в БД" Command="{Binding SaveDataInDbCommand}"></MenuItem>
                <MenuItem Header="Пользователи" Command="{Binding ShowAllUsersCommand}"></MenuItem>
            </MenuItem>
            
            <MenuItem Header="Справочники" >
                <MenuItem Header="Пациенты" Command="{Binding ShowAllPatientsCommand}"></MenuItem>
                <MenuItem Header="Медицинские услуги" Command="{Binding ShowAllMedicalServicesCommand}"></MenuItem>
                <MenuItem Header="Сотрудники" Command="{Binding ShowAllEmployeesCommand}"></MenuItem>
                <Separator />
                <MenuItem Header="Должности сотрудников" Command="{Binding ShowAllPositionsCommand}"></MenuItem>
                <MenuItem Header="Виды медицинских услуг " Command="{Binding ShowAllMedicalServicetypesCommand}"></MenuItem>
                <Separator />
                <MenuItem Header="Реквизиты организации" Command="{Binding ShowOrganizationInfoCommand}"></MenuItem>
            </MenuItem>

            <MenuItem Header="Договора" >
                <MenuItem Header="Оформление договора" Command="{Binding AddContractCommand}"></MenuItem>
                <MenuItem Header="Все договора" Command="{Binding ShowAllContractsCommand}"></MenuItem>
            </MenuItem>

            <MenuItem Header="Справка" >
                <MenuItem Header="О программе" Command="{Binding ShowAboutProgrammCommand}"></MenuItem>
                <MenuItem Header="Помощь" Command="{Binding ShowHelpCommand}"></MenuItem>
            </MenuItem>

            <MenuItem Header="Выход" Command="{Binding ExitCommand}"></MenuItem>
        </Menu>
        <ToolBar Grid.Row="1">
            <Button Command="{Binding ShowAllPatientsCommand}" ToolTip="Пациенты">
                <Image Height="25" MaxHeight="25" Source="images/patient.png" Stretch="Fill" />
            </Button>
            <Button Command="{Binding ShowAllMedicalServicesCommand}" ToolTip="Медицинские услуги">
                <Image Height="25" MaxHeight="25" Source="/images/medical-services.png" Stretch="Fill" />
            </Button>
            <Button Command="{Binding ShowAllEmployeesCommand}" ToolTip="Сотрудники">
                <Image Height="25" MaxHeight="25" Source="/images/employee.png" Stretch="Fill" />
            </Button>

            <Separator />
            <Button Command="{Binding ShowOrganizationInfoCommand}" ToolTip="Реквизиты">
                <Image Height="25" MaxHeight="25" Source="/images/hospital.png" Stretch="Fill" />
            </Button>
            
            <Separator />
            <Button Command="{Binding ShowAllContractsCommand}" ToolTip="Договора">
                <Image Height="25" MaxHeight="25" Source="/images/contract.png" Stretch="Fill" />
            </Button>
        </ToolBar>

        <StatusBar Grid.Column="0" Grid.Row="3" Style="{StaticResource StatusBarStyle}">
            <TextBlock Text="{Binding StatusService.StatusMessage, Mode=OneWay}"></TextBlock>
        </StatusBar>
        
    </Grid>
</Window>
