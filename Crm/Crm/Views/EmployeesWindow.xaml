<Window x:Class="Crm.Views.EmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crm.Views"
        mc:Ignorable="d"
        Title="Сотрудники" 
        Height="650" Width="1000"
        MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}"
            xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <xctk:BusyIndicator IsBusy="{Binding IsPrgBusy}"
            BusyContent="Минутку..." Margin="2">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*"></ColumnDefinition>
            <ColumnDefinition Width="30*" MaxWidth="200"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Style="{StaticResource TytletStyle}">
            Сотружники
        </Label>

        <DataGrid MinHeight="150"
   Grid.Column="0" Grid.Row="1"
   IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
   SelectionMode="Single"
   VerticalScrollBarVisibility="Auto"
   AutoGenerateColumns="False"
   CanUserReorderColumns="False"
   Margin="10"
   ItemsSource="{Binding Entities, Mode=TwoWay}"
   SelectedItem="{Binding SelectedEntity}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding LastName}" Header="Фамилия" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding FirstName}" Header="Имя" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding MiddleName}" Header="Отчество" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Path=Position.PositionName}" Header="Должность" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding PhoneNumber}" Header="Телефон" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Email}" Header="e-mail" Width="5*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Grid.Row="1">
            <Button Command="{Binding AddCompanyCommand}"
                    Style="{StaticResource WindowButtonStyle}">Дабавить</Button>
            <Button Command="{Binding EditCommand}"
                    Style="{StaticResource WindowButtonStyle}">Редактировать</Button>
            <Button Command="{Binding DelCommand}"
                    Style="{StaticResource WindowCloseButtonStyle}">Удалить</Button>
            <Button Command="{Binding RefreshCommand}"
                    Style="{StaticResource WindowButtonStyle}">Обновить</Button>

            <Button Command="{Binding ExportDataCommand}"
                    Style="{StaticResource WindowButtonStyle}">Экспорт в Excel</Button>
            <!--<Button Command="{Binding ImportDataCommand}"
                    Style="{StaticResource WindowButtonStyle}">Импорт данных</Button>-->
        </StackPanel>
        
   
        <StatusBar Grid.Column="0" Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <TextBlock Text="{Binding StatusService.StatusMessage, Mode=OneWay}"></TextBlock>
        </StatusBar>
    </Grid>
    </xctk:BusyIndicator>
</Window>
