<Window x:Class="Crm.Views.AddPaymentForContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crm.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Договор" 
        Height="700" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"></ColumnDefinition>
            <ColumnDefinition Width="60*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="Auto" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label x:Name="labelTitle"
               Grid.Column="0" Grid.Row="0"
               Margin="10"
               Grid.ColumnSpan="2"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Bottom">
            Введите данные о платеже:
        </Label>

        <Label Grid.Column="0" Grid.Row="1">Номер договора:</Label>
        <TextBox Grid.Column="1" Grid.Row="1"
                 Margin="20,10,20,10"
                 Padding="10"
                 IsReadOnly="True"
                 IsEnabled="False"
                 Text="{Binding Path=MainEntity.Contract.ContractNumber,Mode=OneWay,  UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Column="0" Grid.Row="2">Пациент:</Label>
        <TextBox Grid.Column="1" Grid.Row="2"
         Margin="20,10,20,10"
         Padding="10"
         IsReadOnly="True"
         IsEnabled="False"
         Text="{Binding Path=MainEntity.Contract.Patient.FIO, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Column="0" Grid.Row="3">Дата и время платежа:</Label>
        <DatePicker Grid.Column="1" Grid.Row="3"
MaxWidth="400" MinWidth="200"
HorizontalAlignment="Left"
Margin="20,10,20,10"
Padding="10"
VerticalAlignment="Center"
SelectedDate="{Binding Path=MainEntity.PaymentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Grid.Column="0" Grid.Row="4">Способ оплаты:</Label>
        <ComboBox Grid.Column="1" Grid.Row="4" 
          Margin="20,10,20,10"
          Padding="10"
          ItemsSource="{Binding PaymentMethodList, Mode=OneWay}"
          SelectedValue="{Binding Path=MainEntity.PaymentMethod}"
          Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
        </ComboBox>

        <Label Grid.Column="0" Grid.Row="5">Сумма платежа:</Label>
        <xctk:DecimalUpDown Grid.Column="1" Grid.Row="5"
            FormatString="C2" 
            Value="{Binding MainEntity.PaymentAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
            Minimum="0"
            Maximum="1000000"
            Increment="0.01"
            Width="200"
            Margin="20,10,20,10"
            Padding="10"
            HorizontalAlignment="Left"
            Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Grid.Column="0" Grid.Row="6">ID транзакции:</Label>
        <TextBox Grid.Column="1" Grid.Row="6"
                 Margin="20,10,20,10"
Padding="10"
     Text="{Binding Path=MainEntity.TransactionId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
     Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Grid.Column="0" Grid.Row="7">Примечания к платежу:</Label>
        <TextBox Grid.Column="1" Grid.Row="7"
            MinHeight="120" MinWidth="320" TextWrapping="Wrap"
            Margin="20,10,20,10"
           Padding="10"
Text="{Binding Path=MainEntity.PaymentNotes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <StackPanel Grid.Column="1" Grid.Row="9" Orientation="Horizontal">
            <Button Margin="10,10,10,10" Padding="10"
            MinWidth="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Command="{Binding SaveCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                Сохранить
            </Button>

            <Button Margin="10,10,10,10" Padding="10"
            MinWidth="120"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding CloseWindowCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                Отмена
            </Button>

            <Button Margin="10,10,10,10" Padding="10"
MinWidth="120"
HorizontalAlignment="Right"
VerticalAlignment="Center">
                Очистить
            </Button>
        </StackPanel>
    </Grid>
</Window>
