<Window x:Class="Crm.Views.AddPaymentForContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crm.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Договор" 
        Height="700" Width="800"
        MinHeight="620" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">
    <xctk:BusyIndicator IsBusy="{Binding IsPrgBusy}"
                BusyContent="Минутку..." Margin="2">

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="70*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label  Style="{StaticResource TytletStyle}">
            Введите данные о платеже:
        </Label>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="1">Номер договора:</Label>
        <Label Grid.Column="1" Grid.Row="1"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" 
                 Grid.Column="2" Grid.Row="1"
                 IsReadOnly="True"
                 IsEnabled="False"
                 Text="{Binding Path=MainEntity.Contract.ContractNumber,Mode=OneWay,  UpdateSourceTrigger=PropertyChanged}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="2">Пациент:</Label>
        <Label Grid.Column="1" Grid.Row="2"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" 
                 Grid.Column="2" Grid.Row="2"
         IsReadOnly="True"
         IsEnabled="False"
         Text="{Binding Path=MainEntity.Contract.Patient.FIO, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="3">Дата платежа:</Label>
        <Label Grid.Column="1" Grid.Row="3"  Style="{StaticResource RequiredStyle}">*</Label>
        <DatePicker Grid.Column="2" Grid.Row="3"
                    Style="{StaticResource InputDatePickerStyle}"
VerticalAlignment="Center"
SelectedDate="{Binding Path=MainEntity.PaymentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="4">Способ оплаты:</Label>
        <Label Grid.Column="1" Grid.Row="4"  Style="{StaticResource RequiredStyle}">*</Label>
        <ComboBox Grid.Column="2" Grid.Row="4" 
          ItemsSource="{Binding PaymentMethodList, Mode=OneWay}"
          SelectedValue="{Binding Path=MainEntity.PaymentMethod}"
          Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"
                  Style="{StaticResource InputComboBoxStyle}">
        </ComboBox>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="5">Сумма платежа:</Label>
        <Label Grid.Column="1" Grid.Row="5"  Style="{StaticResource RequiredStyle}">*</Label>
        <xctk:DecimalUpDown Grid.Column="2" Grid.Row="5"
                            Style="{StaticResource InputDecimalUpDownStyle}" 
                            Value="{Binding MainEntity.PaymentAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                            Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>
        <!--FormatString="C2" 
Minimum="0"
Maximum="1000000"
Increment="0.01"
HorizontalAlignment="Left"-->



        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="6">ID транзакции:</Label>
        <Label Grid.Column="1" Grid.Row="6"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" 
                 Grid.Column="2" Grid.Row="6"
                 Text="{Binding Path=MainEntity.TransactionId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
     Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="7">Примечания к платежу:</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" 
                 Grid.Column="2" Grid.Row="7"
                 MinHeight="120" MinWidth="320" TextWrapping="Wrap"
                 
                 Text="{Binding Path=MainEntity.PaymentNotes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <StackPanel Grid.Column="0" Grid.Row="9" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Grid.ColumnSpan="3">
            <Button Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowButtonStyle}">
                Сохранить
            </Button>

            <Button Command="{Binding CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowCloseButtonStyle}">
                Отмена
            </Button>
                <Button Style="{StaticResource WindowButtonStyle}"
        Command="{Binding ClearCommand}">
                    Очистить
                </Button>
            </StackPanel>
    </Grid>
    </xctk:BusyIndicator>
</Window>
