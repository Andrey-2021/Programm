<Window x:Class="Crm.Views.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Пациент" 
        Height="950" Width="800"
        MinHeight="850" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}"
                xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <xctk:BusyIndicator IsBusy="{Binding IsPrgBusy}"
                BusyContent="Минутку..." Margin="2">

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="70*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Style="{StaticResource TytletStyle}">
            Введите данные о пациенте:
        </Label>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="1">Фамилия:</Label>
        <Label Grid.Column="1" Grid.Row="1"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="1"
                Text="{Binding Path=MainEntity.LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="2">Имя:</Label>
        <Label Grid.Column="1" Grid.Row="2"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="2"
                Text="{Binding Path=MainEntity.FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="3">Отчество:</Label>
        <Label Grid.Column="1" Grid.Row="3"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="3" 
                 Text="{Binding Path=MainEntity.MiddleName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="4">Дата рождения:</Label>
        <Label Grid.Column="1" Grid.Row="4"  Style="{StaticResource RequiredStyle}">*</Label>
        <DatePicker Grid.Row="4" Grid.Column="2"
                    Style="{StaticResource InputDatePickerStyle}"
            SelectedDate="{Binding Path=MainEntity.BirthDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="5">Пол:</Label>
        <Label Grid.Column="1" Grid.Row="5"  Style="{StaticResource RequiredStyle}">*</Label>
        <!--<TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="1" Grid.Row="5"
                 Text="{Binding Path=MainEntity.Gender, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>-->
        <ComboBox Grid.Column="2" Grid.Row="5" 
           ItemsSource="{Binding GendersList, Mode=OneWay}"
           SelectedValue="{Binding Path=MainEntity.Gender}"
           Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"
                  Style="{StaticResource InputComboBoxStyle}">
        </ComboBox>
        

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="6">Телефон:</Label>
        <Label Grid.Column="1" Grid.Row="6"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="6"
                 Text="{Binding Path=MainEntity.PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="7">e-mail:</Label>
        <Label Grid.Column="1" Grid.Row="7"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="7" 
                Text="{Binding Path=MainEntity.Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="8">Адрес проживания:</Label>
        <Label Grid.Column="1" Grid.Row="8"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="8" 
                Text="{Binding Path=MainEntity.Address, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="9">Серия паспорта:</Label>
        <Label Grid.Column="1" Grid.Row="9"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="9" 
                Text="{Binding Path=MainEntity.PassportSeries, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="10">Номер паспорта:</Label>
        <Label Grid.Column="1" Grid.Row="10"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="10" 
                Text="{Binding Path=MainEntity.PassportNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="11">Дата выдачи паспорта:</Label>
        <Label Grid.Column="1" Grid.Row="11"  Style="{StaticResource RequiredStyle}">*</Label>
        <DatePicker Grid.Row="11" Grid.Column="2"
                    Style="{StaticResource InputDatePickerStyle}"
	                SelectedDate="{Binding Path=MainEntity.PassportIssueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="12">Орган, выдавший паспорт:</Label>
        <Label Grid.Column="1" Grid.Row="12"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="12" 
                Text="{Binding Path=MainEntity.PassportIssuingAuthority, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>


        <StackPanel Grid.Column="0" Grid.Row="14" 
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Grid.ColumnSpan="3">
            <Button Command="{Binding SaveCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            Style="{StaticResource WindowButtonStyle}">
                Сохранить
            </Button>

            <Button Command="{Binding CloseWindowCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            Style="{StaticResource WindowCloseButtonStyle}">
                Отмена
            </Button>
                <Button Style="{StaticResource WindowButtonStyle}"
        Command="{Binding ClearCommand}">
                    Очистить
                </Button>
            </StackPanel>
    </Grid>
    </xctk:BusyIndicator>
</Window>
