<Window x:Class="UniverApp.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Пользователь" 
        Height="500" Width="700"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="70*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto" MinHeight="70"></RowDefinition>
            <RowDefinition Height="Auto" MinHeight="70"></RowDefinition>
            <RowDefinition Height="Auto" MinHeight="70"></RowDefinition>
            <RowDefinition Height="Auto" MinHeight="70"></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>

        </Grid.RowDefinitions>

        <Label Style="{StaticResource TytletStyle}">
            Введите данные о пользователе:
        </Label>

        <Label Grid.Column="0" Grid.Row="1" Style="{StaticResource InputInfoStyle}">Логин:</Label>
        <Label Grid.Column="1" Grid.Row="1"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Name="log" Grid.Column="2" Grid.Row="1"
                 Style="{StaticResource InputTextBoxStyle}"
                 Text="{Binding Path=MainEntity.Login, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Grid.Column="0" Grid.Row="2" Style="{StaticResource InputInfoStyle}">Пароль:</Label>
        <Label Grid.Column="1" Grid.Row="2" Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Name="pas" Grid.Column="2" Grid.Row="2"
                 Style="{StaticResource InputTextBoxStyle}"
                 Text="{Binding Path=MainEntity.Password, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}" />



        <Label Grid.Column="0" Grid.Row="3" Style="{StaticResource InputInfoStyle}">Повторите пароль:</Label>
        <Label Grid.Column="1" Grid.Row="3" Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Grid.Column="2" Grid.Row="3" 
                 Style="{StaticResource InputTextBoxStyle}"
                 Text="{Binding Path=MainEntity.ConfirmedPassword, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}" />

        <Label Grid.Column="0" Grid.Row="4" Style="{StaticResource InputInfoStyle}">Роль:</Label>
        <Label Grid.Column="1" Grid.Row="4" Style="{StaticResource RequiredStyle}">*</Label>
        
        <ComboBox Grid.Column="2" Grid.Row="4"
           Style="{StaticResource InputComboBoxStyle}"
           ItemsSource="{Binding RoleEnumList, Mode=OneWay}"
           SelectedValue="{Binding Path=MainEntity.Role, ValidatesOnNotifyDataErrors=True}"
           Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
        </ComboBox>

        <StackPanel Grid.Column="0" Grid.Row="6" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Grid.ColumnSpan="3">
            <Button Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowButtonStyle}">
                Сохранить
            </Button>

            <Button Command="{Binding CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowCloseButtonStyle}">
                Отмена
            </Button>
        </StackPanel>


    </Grid>
</Window>
