<Window x:Class="Crm.Views.AboutProgrammWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crm.Views"
        mc:Ignorable="d"
        Title="О программе" 
        Height="610" Width="850"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30" Orientation="Vertical">

            <!-- Заголовок -->
            <TextBlock Text="Медицинская информационная система «MedSoft»"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Версия: 1.0.0"
                       FontSize="16"
                       Foreground="#34495E"
                       
                       HorizontalAlignment="Right"/>

            <!-- Назначение -->
            <TextBlock Text="Назначение программы:"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5"/>
            <TextBlock Text="Программа предназначена для автоматизации учёта и управления деятельностью медицинских учреждений (клиник, центров, кабинетов)."
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="10,0,0,15"/>
            
            <Border BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Margin="0,10,0,0"/>
            
            <!-- Основной функционал -->
            <TextBlock Text="Основной функционал:"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,10,0,10"/>

            <TextBlock Text="Учёт пациентов"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#2980B9"/>
            <TextBlock Text="Ведение карточек пациентов: ФИО, дата рождения, контактные данные, история обращений и т.д."
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="15,0,0,10"/>

            <TextBlock Text="Учёт медицинских услуг"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#27AE60"/>
            <TextBlock Text="Справочник услуг: наименование, стоимость, категория, длительность, код услуги."
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="15,0,0,10"/>

            <TextBlock Text="Учёт сотрудников"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#8E44AD"/>
            <TextBlock Text="Информация о врачах и медперсонале: должность, контакты."
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="15,0,0,10"/>

            <TextBlock Text="Учёт договоров с клиентами"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#D35400"/>
            <TextBlock Text="Регистрация договоров на обслуживание и оказание платных услуг: номер договора, срок действия, условия, привязанные услуги и пациенты."
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="15,0,0,20"/>

            <!-- Дополнительные возможности -->
            <!--<TextBlock Text="Дополнительные возможности:"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5"/>
            <TextBlock Text="Поиск и фильтрация данных, формирование отчётов, экспорт в Excel/PDF."
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="10,0,0,15"/>-->

            <!-- Подвал -->
            <TextBlock Text="© 2026 ООО «Медицинские технологии»."
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,10"/>
            <TextBlock Text="support@medsoft.ru"
                       HorizontalAlignment="Center"
                       Foreground="#2980B9"
                       TextDecorations="Underline"/>

        </StackPanel>
    </ScrollViewer>
</Window>
