<Window x:Class="Crm.Views.AddContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Договор" 
        Height="850" Width="1200"
        MinHeight="800" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <xctk:BusyIndicator IsBusy="{Binding IsPrgBusy}"
            BusyContent="Минутку..." Margin="2">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"></ColumnDefinition>
            <ColumnDefinition Width="60*"></ColumnDefinition>
            <ColumnDefinition Width="30"></ColumnDefinition>
            <ColumnDefinition Width="50*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="Auto" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" ></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label  Style="{StaticResource TytletStyle}">
            Введите данные о договоре:
        </Label>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="1">Номер договора:</Label>

        <TextBox Style="{StaticResource InputTextBoxStyle}" 
                 Grid.Column="1" Grid.Row="1"
                 Text="{Binding Path=MainEntity.ContractNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <!--<TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="1" Grid.Row="1"
                 Margin="20,10,20,10" 
                 Padding="10"
     Text="{Binding Path=MainEntity.ContractNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
     Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>-->

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="2">Дата заключения договора:</Label>
        <DatePicker Grid.Column="1" Grid.Row="2"
                    Style="{StaticResource InputDatePickerStyle}"
                    SelectedDate="{Binding Path=MainEntity.ContractDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="3">Дата начала действия договора:</Label>
        <DatePicker Grid.Column="1" Grid.Row="3"
                    Style="{StaticResource InputDatePickerStyle}"
                    SelectedDate="{Binding Path=MainEntity.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="4">Дата окончания действия договора:</Label>
        <DatePicker Grid.Column="1" Grid.Row="4"
                    Style="{StaticResource InputDatePickerStyle}"
                    SelectedDate="{Binding Path=MainEntity.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="5">Общая сумма договора:</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="1" Grid.Row="5"
                 IsReadOnly="True"
                 IsEnabled="False"
                 Text="{Binding Path=MainEntity.TotalAmount, Mode=OneWay}"/>
        <!--<xctk:DecimalUpDown Grid.Column="1" Grid.Row="5"
                    FormatString="C2" 
                    Value="{Binding MainEntity.TotalAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    Minimum="0"
                    Maximum="1000000"
                    Increment="0.01"
                    Width="200"
                    Margin="20,10,20,10"
                    Padding="10"
                    HorizontalAlignment="Left"
                    Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>-->

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="6">Общая сумма договора прописью:</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="1" Grid.Row="6"
                 IsReadOnly="True"
                 IsEnabled="False"
                 Text="{Binding Path=MainEntity.TotalAmountText, Mode=OneWay}"/>
        <!--<TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="1" Grid.Row="6"
                 Margin="20,10,20,10"
                 Padding="10"
                 Text="{Binding Path=MainEntity.TotalAmountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>-->

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="7">Статус оплаты:</Label>
        <ComboBox Grid.Column="1" Grid.Row="7" 
                  Style="{StaticResource InputComboBoxStyle}"
                  ItemsSource="{Binding PaymentStatusList, Mode=OneWay}"
                  SelectedValue="{Binding Path=MainEntity.PaymentStatus}"
                  Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>


        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="8">Статус договора:</Label>
        <ComboBox Grid.Column="1" Grid.Row="8" 
                  Style="{StaticResource InputComboBoxStyle}"
                  ItemsSource="{Binding ContractStatusList, Mode=OneWay}"
                  SelectedValue="{Binding Path=MainEntity.ContractStatus}"
                  Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="9">Примечания к договору:</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" 
                 Grid.Column="1" Grid.Row="9"
                 MinHeight="120" MinWidth="320" TextWrapping="Wrap"
                 Text="{Binding Path=MainEntity.Notes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="3" Grid.Row="1"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom">Выберите пациента:</Label>
        <DataGrid MinHeight="50"
           Grid.Column="3" Grid.Row="2" Grid.RowSpan="4"
           IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
           SelectionMode="Single"
           VerticalScrollBarVisibility="Auto"
           AutoGenerateColumns="False"
           CanUserReorderColumns="False"
           Margin="5 5 5 5"
           ItemsSource="{Binding Patients, Mode=TwoWay}"
           SelectedValuePath="Id"
           SelectedValue="{Binding Path=MainEntity.PatientId, ValidatesOnNotifyDataErrors=True}"
           Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="MediumAquamarine"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="MediumAquamarine"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding LastName}" Header="Фамилия" Width="5*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="3" Grid.Row="6"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom">Ответственный сотрудник:</Label>
        <DataGrid MinHeight="50"
           Grid.Column="3" Grid.Row="7" Grid.RowSpan="3"
           IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
           SelectionMode="Single"
           VerticalScrollBarVisibility="Auto"
           AutoGenerateColumns="False"
           CanUserReorderColumns="False"
           Margin="5 5 5 5"
           ItemsSource="{Binding Employees, Mode=TwoWay}"
           SelectedValuePath="Id"
           SelectedValue="{Binding Path=MainEntity.EmployeeId, ValidatesOnNotifyDataErrors=True}"
           Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="MediumAquamarine"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="MediumAquamarine"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding LastName}" Header="Фамилия" Width="5*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Grid.Row="11" Orientation="Horizontal"
                    Grid.ColumnSpan="3">
            <Button Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowButtonStyle}">
                Сохранить
            </Button>
            <Button Command="{Binding CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowCloseButtonStyle}">
                Отмена
            </Button>
            <Button Style="{StaticResource WindowButtonStyle}"
                    Command="{Binding ClearCommand}">
                Очистить
            </Button>
        </StackPanel>
    </Grid>
    </xctk:BusyIndicator>
</Window>
