<Window x:Class="Crm.Views.AddContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crm.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Договор" 
        Height="1000" Width="800"
        MinHeight="750" MinWidth="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"></ColumnDefinition>
            <ColumnDefinition Width="70*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="Auto" ></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MinHeight="100" MaxHeight="100"></RowDefinition>
            <RowDefinition Height="20*" MinHeight="100" MaxHeight="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label x:Name="labelTitle"
               Grid.Column="0" Grid.Row="0"
               Margin="10"
               Grid.ColumnSpan="2"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Bottom">
            Введите данные о договоре:
        </Label>

        <Label Grid.Column="0" Grid.Row="1">Номер договора:</Label>
        <TextBox Grid.Column="1" Grid.Row="1"
     Text="{Binding Path=MainEntity.ContractNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
     Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Grid.Column="0" Grid.Row="2">Дата заключения договора:</Label>
        <DatePicker Grid.Column="1" Grid.Row="2"
    MaxWidth="400" MinWidth="200"
    HorizontalAlignment="Left"
    Margin="20,10,20,10"
    Padding="10"
    VerticalAlignment="Center"
    SelectedDate="{Binding Path=MainEntity.ContractDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Grid.Column="0" Grid.Row="3">Дата начала действия договора:</Label>
        <DatePicker Grid.Column="1" Grid.Row="3"
MaxWidth="400" MinWidth="200"
HorizontalAlignment="Left"
Margin="20,10,20,10"
Padding="10"
VerticalAlignment="Center"
SelectedDate="{Binding Path=MainEntity.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>


        <Label Grid.Column="0" Grid.Row="4">Дата окончания действия договора:</Label>
        <DatePicker Grid.Column="1" Grid.Row="4"
MaxWidth="400" MinWidth="200"
HorizontalAlignment="Left"
Margin="20,10,20,10"
Padding="10"
VerticalAlignment="Center"
SelectedDate="{Binding Path=MainEntity.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>


        <Label Grid.Column="0" Grid.Row="5">Общая сумма договора:</Label>
        <xctk:DecimalUpDown Grid.Column="1" Grid.Row="5"
                    FormatString="C2" 
                    Value="{Binding MainEntity.TotalAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    Minimum="0"
                    Maximum="1000000"
                    Increment="0.01"
                    Width="200"
                    Margin="5 5 5 5"
                    HorizontalAlignment="Left"
                    Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Grid.Column="0" Grid.Row="6">Общая сумма договора прописью:</Label>
        <TextBox Grid.Column="1" Grid.Row="6"
                 MinHeight="150" MinWidth="320" TextWrapping="Wrap"
                 Text="{Binding Path=MainEntity.TotalAmountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>


        <Label Grid.Column="0" Grid.Row="7">Статус оплаты:</Label>
        <ComboBox Grid.Column="1" Grid.Row="7" 
                  Margin="5,5,5,5" Padding="5"
                  ItemsSource="{Binding PaymentStatusList, Mode=OneWay}"
                  SelectedValue="{Binding Path=MainEntity.PaymentStatus}"
                  Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
        </ComboBox>

        <Label Grid.Column="0" Grid.Row="8">Статус договора:</Label>
        <ComboBox Grid.Column="1" Grid.Row="8" 
          Margin="5,5,5,5" Padding="5"
          ItemsSource="{Binding ContractStatusList, Mode=OneWay}"
          SelectedValue="{Binding Path=MainEntity.ContractStatus}"
          Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
        </ComboBox>





        <Label Grid.Column="0" Grid.Row="9">примечания к договору:</Label>
        <TextBox Grid.Column="1" Grid.Row="9"
     Text="{Binding Path=MainEntity.Notes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
     Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        
        
        
        
        
        
        
        
        <Label Grid.Column="0" Grid.Row="10">Пациент:</Label>
        <DataGrid MinHeight="50"
           Grid.Column="1" Grid.Row="10"
           IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
           SelectionMode="Single"
           VerticalScrollBarVisibility="Auto"
           AutoGenerateColumns="False"
           CanUserReorderColumns="False"
           Margin="5 5 5 5"
           ItemsSource="{Binding Patients, Mode=TwoWay}"
           SelectedValuePath="Id"
           SelectedValue="{Binding Path=MainEntity.PatientId, ValidatesOnNotifyDataErrors=True}"
           Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="MediumAquamarine"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="MediumAquamarine"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding LastName}" Header="Фамилия" Width="5*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        
        
        <Label Grid.Column="0" Grid.Row="11">Ответственный сотрудник:</Label>
        <DataGrid MinHeight="50"
           Grid.Column="1" Grid.Row="11"
           IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
           SelectionMode="Single"
           VerticalScrollBarVisibility="Auto"
           AutoGenerateColumns="False"
           CanUserReorderColumns="False"
           Margin="5 5 5 5"
           ItemsSource="{Binding Employees, Mode=TwoWay}"
           SelectedValuePath="Id"
           SelectedValue="{Binding Path=MainEntity.EmployeeId, ValidatesOnNotifyDataErrors=True}"
           Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="MediumAquamarine"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="MediumAquamarine"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding LastName}" Header="Фамилия" Width="5*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>















        <StackPanel Grid.Column="1" Grid.Row="12" Orientation="Horizontal">
            <Button Margin="10,10,10,10" Padding="10"
                    MinWidth="120"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                Сохранить
            </Button>

            <Button Margin="10,10,10,10" Padding="10"
                    MinWidth="120"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                Отмена
            </Button>
        </StackPanel>
    </Grid>
</Window>
