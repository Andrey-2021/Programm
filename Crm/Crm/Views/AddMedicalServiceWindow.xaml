<Window x:Class="Crm.Views.AddMedicalServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crm.Views"
        xmlns:converter="clr-namespace:Crm"
         xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Медицинская услуга" 
        Height="650" Width="800"
        MinHeight="550" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">
    <xctk:BusyIndicator IsBusy="{Binding IsPrgBusy}"
                BusyContent="Минутку..." Margin="2">

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="70*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="50"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label  Style="{StaticResource TytletStyle}">
            Введите данные о медицинской услуге:
        </Label>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="1">Наименование услуги:</Label>
        <Label Grid.Column="1" Grid.Row="1"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="1"
             Text="{Binding Path=MainEntity.ServiceName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="2">Код услуги:</Label>
        <Label Grid.Column="1" Grid.Row="2"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="2"
             Text="{Binding Path=MainEntity.ServiceCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="3">Цена:</Label>
        <Label Grid.Column="1" Grid.Row="3"  Style="{StaticResource RequiredStyle}">*</Label>
        <!--<TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center"
             Margin="10" Padding="5" Width="200">
            <TextBox Style="{StaticResource InputTextBoxStyle}".Text>
                <Binding Path="MainEntity.ServicePrice" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                    <Binding.Converter>
                        <converter:StrToIntConverter></converter:StrToIntConverter>
                    </Binding.Converter>
                </Binding>
            </TextBox.Text>
        </TextBox>-->

        <!--https://stackoverflow.com/questions/382676/good-numericupdown-equivalent-in-wpf-->
        <xctk:DecimalUpDown Grid.Column="2" Grid.Row="3"
                            FormatString="C2" 
                            Value="{Binding MainEntity.ServicePrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                            Minimum="0"
                            Maximum="1000000"
                            Increment="0.01"
                            Width="200"
                            Margin="5 5 5 5"
                            HorizontalAlignment="Left"
                            Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="4">НДС (%):</Label>
        <Label Grid.Column="1" Grid.Row="4"  Style="{StaticResource RequiredStyle}">*</Label>
        <xctk:IntegerUpDown Grid.Column="2" Grid.Row="4"
                            Style="{StaticResource InputIntegerUpDownStyle}"
                            Value="{Binding MainEntity.NdsPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                            HorizontalAlignment="Left"
                            Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>
        
        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="5">Вид услуги:</Label>
        <Label Grid.Column="1" Grid.Row="5"  Style="{StaticResource RequiredStyle}">*</Label>
        <DataGrid MinHeight="50"
                  Grid.Column="2" Grid.Row="5"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single"
                  VerticalScrollBarVisibility="Auto"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  Margin="5 15 5 15"
                  ItemsSource="{Binding Entities, Mode=TwoWay}"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding Path=MainEntity.MedicalServiceTypeId, ValidatesOnNotifyDataErrors=True}"
                  Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="MediumAquamarine"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="MediumAquamarine"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" 
                                    Header="Название типа медицинской услуги" 
                                    Width="5*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="0" Grid.Row="7" 
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Grid.ColumnSpan="3">
            
            <Button Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowButtonStyle}">
                Сохранить
            </Button>

            <Button Command="{Binding CloseWindowCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            Style="{StaticResource WindowCloseButtonStyle}">
                Отмена
            </Button>
                <Button Style="{StaticResource WindowButtonStyle}"
        Command="{Binding ClearCommand}">
                    Очистить
                </Button>
            </StackPanel>
    </Grid>
    </xctk:BusyIndicator>

</Window>
