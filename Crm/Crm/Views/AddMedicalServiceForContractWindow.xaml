<Window x:Class="Crm.Views.AddMedicalServiceForContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crm.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Мед.услуга" 
        Height="800" Width="1200"
        MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"></ColumnDefinition>
            <ColumnDefinition Width="100*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="250"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label x:Name="labelTitle"
       Grid.Column="0" Grid.Row="0"
       Margin="10"
       Grid.ColumnSpan="2"
       HorizontalContentAlignment="Center"
       VerticalContentAlignment="Bottom">
            Введите данные о рказанной медицинской услуге:
        </Label>

        <Label Grid.Column="0" Grid.Row="1">Номер договора:</Label>
        <TextBox Grid.Column="1" Grid.Row="1"
         Margin="20,10,20,10"
         Padding="10"
         IsReadOnly="True"
         IsEnabled="False"
         Text="{Binding Path=MainEntity.Contract.ContractNumber,Mode=OneWay,  UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Column="0" Grid.Row="2">Пациент:</Label>
        <TextBox Grid.Column="1" Grid.Row="2"
 Margin="20,10,20,10"
 Padding="10"
 IsReadOnly="True"
 IsEnabled="False"
 Text="{Binding Path=MainEntity.Contract.Patient.FIO, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Column="0" Grid.Row="3">Выберите медицинскую услугу:</Label>
        <DataGrid Height="200"
          Grid.Column="1" Grid.Row="3"
          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
          SelectionMode="Single"
          VerticalScrollBarVisibility="Auto"
          AutoGenerateColumns="False"
          CanUserReorderColumns="False"
          Margin="5 15 5 15"
                  
          ItemsSource="{Binding MedicalServices, Mode=TwoWay}"
          
          Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
            <!--SelectedValue="{Binding Path=SelectedMedicalService, ValidatesOnNotifyDataErrors=True}"-->
            <DataGrid.SelectedValue >
                <Binding Path="SelectedMedicalService">
                    <Binding.ValidationRules>
                        <DataErrorValidationRule />
                    </Binding.ValidationRules>
                </Binding>
                
            </DataGrid.SelectedValue>
            
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="MediumAquamarine"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="MediumAquamarine"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding ServiceName}" Header="Название услуги" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding ServiceCode}" Header="Код услуги" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Path=MedicalServiceType.Name}" Header="Вид услуги" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding ServicePrice}" Header="Стоимость услуги" Width="5*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>


        <Label Grid.Column="0" Grid.Row="4">Медицинская услуга:</Label>
        <TextBox Grid.Column="1" Grid.Row="4"
Margin="20,10,20,10"
Padding="10"
IsReadOnly="True"
IsEnabled="False"
Text="{Binding Path=MainEntity.MedicalService.ServiceName, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>
        

        <Label Grid.Column="0" Grid.Row="5">Количество услуг:</Label>
        <xctk:IntegerUpDown Grid.Column="1" Grid.Row="5"
    FormatString="C2" 
    Value="{Binding MainEntity.Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
    Minimum="0"
    Maximum="1000000"
    Increment="1"
    Width="200"
    Margin="20,10,20,10"
    Padding="5"
    HorizontalAlignment="Left"
    Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

        <Label Grid.Column="0" Grid.Row="6">Цена услуги:</Label>
        <TextBox Grid.Column="1" Grid.Row="6"
 Margin="20,10,20,10"
 Padding="10"
 IsReadOnly="True"
 IsEnabled="False"
 Text="{Binding Path=MainEntity.Price,Mode=OneWay,  UpdateSourceTrigger=PropertyChanged}"/>


        <Label Grid.Column="0" Grid.Row="7">Скидка (руб.):</Label>
        <xctk:DecimalUpDown Grid.Column="1" Grid.Row="7"
FormatString="C2" 
Value="{Binding MainEntity.Discount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
Minimum="0"
Maximum="1000000"
Increment="0.01"
Width="200"
Margin="20,10,20,10"
Padding="5"
HorizontalAlignment="Left"
Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>


        <Label Grid.Column="0" Grid.Row="8">Итого:</Label>
        <TextBox Grid.Column="1" Grid.Row="8"
Margin="20,10,20,10"
Padding="10"
IsReadOnly="True"
IsEnabled="False"
Text="{Binding Path=MainEntity.ItemTotal,Mode=OneWay,  UpdateSourceTrigger=PropertyChanged}"/>


        <StackPanel Grid.Column="1" Grid.Row="10" Orientation="Horizontal">
            <Button Margin="10,10,10,10" Padding="10"
            MinWidth="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Command="{Binding SaveCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                Сохранить
            </Button>

            <Button Margin="10,10,10,10" Padding="10"
            MinWidth="120"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding CloseWindowCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                Отмена
            </Button>

            <Button Margin="10,10,10,10" Padding="10"
MinWidth="120"
HorizontalAlignment="Right"
VerticalAlignment="Center">
                Очистить
            </Button>
        </StackPanel>
    </Grid>
</Window>
