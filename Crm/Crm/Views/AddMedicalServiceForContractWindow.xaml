<Window x:Class="Crm.Views.AddMedicalServiceForContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crm.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Мед.услуга" 
        Height="800" Width="1200"
        MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterOwner">
    <xctk:BusyIndicator IsBusy="{Binding IsPrgBusy}"
            BusyContent="Минутку..." Margin="2">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="100*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="250"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="20*" MaxHeight="60"></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label  Style="{StaticResource TytletStyle}">
            Введите данные о указанной медицинской услуге:
        </Label>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="1">Номер договора:</Label>
        <Label Grid.Column="1" Grid.Row="1"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" 
                 Grid.Column="2" Grid.Row="1"
         IsReadOnly="True"
         IsEnabled="False"
         Text="{Binding Path=MainEntity.Contract.ContractNumber,Mode=OneWay,  UpdateSourceTrigger=PropertyChanged}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="2">Пациент:</Label>
        <Label Grid.Column="1" Grid.Row="2"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" 
                 Grid.Column="2" Grid.Row="2"
 IsReadOnly="True"
 IsEnabled="False"
 Text="{Binding Path=MainEntity.Contract.Patient.FIO, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"/>

        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="3">Выберите медицинскую услугу:</Label>
        <Label Grid.Column="1" Grid.Row="3"  Style="{StaticResource RequiredStyle}">*</Label>
        <DataGrid Height="200"
          Grid.Column="2" Grid.Row="3"
          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
          SelectionMode="Single"
          VerticalScrollBarVisibility="Auto"
          AutoGenerateColumns="False"
          CanUserReorderColumns="False"
          Margin="5 15 15 15"
          ItemsSource="{Binding MedicalServices, Mode=TwoWay}"
          Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}">
            <!--SelectedValue="{Binding Path=SelectedMedicalService, ValidatesOnNotifyDataErrors=True}"-->
            <DataGrid.SelectedValue >
                <Binding Path="SelectedMedicalService">
                    <Binding.ValidationRules>
                        <DataErrorValidationRule />
                    </Binding.ValidationRules>
                </Binding>
            </DataGrid.SelectedValue>
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="MediumAquamarine"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="MediumAquamarine"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding ServiceName}" Header="Название услуги" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding ServiceCode}" Header="Код услуги" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Path=MedicalServiceType.Name}" Header="Вид услуги" Width="5*"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding ServicePrice}" Header="Стоимость" Width="110"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding NdsPercent}" Header="НДС" Width="50"/>
                <DataGridTextColumn Binding="{Binding PriceWithNds}" Header="Цена с НДС" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>


        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="4">Выбранная медицинская услуга:</Label>
        <Label Grid.Column="1" Grid.Row="4"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" 
                 Grid.Column="2" Grid.Row="4"
                 IsReadOnly="True" 
                 IsEnabled="False"
                 Text="{Binding Path=MainEntity.MedicalService.ServiceName, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"
                 Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>
              



        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="5">Цена услуги:</Label>
        <StackPanel Grid.Column="2" Grid.Row="5" Orientation="Horizontal">
            <!--<Label Grid.Column="1" Grid.Row="2"  Style="{StaticResource RequiredStyle}">*</Label>-->
            <TextBox Style="{StaticResource InputTextBoxStyle}" 
                Grid.Column="2" Grid.Row="6" IsReadOnly="True" IsEnabled="False"
                     Text="{Binding Path=MainEntity.Price,Mode=OneWay,  UpdateSourceTrigger=PropertyChanged}"/>

            <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="6">НДС:</Label>
            <!--<Label Grid.Column="1" Grid.Row="2"  Style="{StaticResource RequiredStyle}">*</Label>-->
            <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="6" IsReadOnly="True" IsEnabled="False"
                     Text="{Binding Path=MainEntity.NdsPercent,Mode=OneWay,  UpdateSourceTrigger=PropertyChanged}"/>

            <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="6">Цена с НДС:</Label>
            <!--<Label Grid.Column="1" Grid.Row="2"  Style="{StaticResource RequiredStyle}">*</Label>-->
            <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="6" IsReadOnly="True" IsEnabled="False"
                     Text="{Binding Path=MainEntity.PriceWithNds,Mode=OneWay,  UpdateSourceTrigger=PropertyChanged}"/>

        </StackPanel>

            <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="6">Количество услуг:</Label>
            <Label Grid.Column="1" Grid.Row="6"  Style="{StaticResource RequiredStyle}">*</Label>
            <xctk:IntegerUpDown Grid.Column="2" Grid.Row="6"
                        Style="{StaticResource InputIntegerUpDownStyle}"
                        Value="{Binding MainEntity.Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
Maximum="1000000"
HorizontalAlignment="Left"
Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>
            


            <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="7">Скидка (руб.):</Label>
        <Label Grid.Column="1" Grid.Row="7"  Style="{StaticResource RequiredStyle}">*</Label>
        <xctk:DecimalUpDown Grid.Column="2" Grid.Row="7"
                            Style="{StaticResource InputDecimalUpDownStyle}"
                            Value="{Binding MainEntity.Discount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                            Maximum="1000000"
                            Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>


        <Label Style="{StaticResource InputInfoStyle}" Grid.Column="0" Grid.Row="8">Итого:</Label>
        <Label Grid.Column="1" Grid.Row="8"  Style="{StaticResource RequiredStyle}">*</Label>
        <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Column="2" Grid.Row="8"
IsReadOnly="True"
IsEnabled="False"
Text="{Binding Path=MainEntity.ItemTotal, Mode=OneWay,  UpdateSourceTrigger=PropertyChanged}"/>


        <StackPanel Grid.Column="1" Grid.Row="10" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Grid.ColumnSpan="3">
            <Button Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowButtonStyle}">
                Сохранить
            </Button>
            <Button Command="{Binding CloseWindowCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowCloseButtonStyle}">
                Отмена
            </Button>
                <Button Style="{StaticResource WindowButtonStyle}"
                        Command="{Binding ClearCommand}">
                    Очистить
                </Button>
            </StackPanel>
    </Grid>
    </xctk:BusyIndicator>
</Window>
