<Window x:Class="Crm.Views.OrganizationInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crm.Views"
        mc:Ignorable="d"
        Title="Карточка организации" 
        Height="700" Width="1400"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"></ColumnDefinition>
            <ColumnDefinition Width="50*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Style="{StaticResource TytletStyle}">
            Введите данные организации
        </Label>

        <StackPanel Margin="5" Grid.Column="0" Grid.Row="1">
        <!-- Основные реквизиты -->
        <GroupBox Header="Общие сведения" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="0" Grid.Column="0" Content="Полное наименование:"/>
                    <Label Grid.Column="1" Grid.Row="0"  Style="{StaticResource RequiredStyle}">*</Label>
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="0" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="1" Grid.Column="0" Content="Сокращённое наименование:"/>
                    <Label Grid.Column="1" Grid.Row="1"  Style="{StaticResource RequiredStyle}">*</Label>
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="1" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.ShortName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="2" Grid.Column="0" Content="Адрес:"/>
                    <Label Grid.Column="1" Grid.Row="2"  Style="{StaticResource RequiredStyle}">*</Label>
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="2" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.Address, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="3" Grid.Column="0" Content="Телефон:"/>
                    <Label Grid.Column="1" Grid.Row="3"  Style="{StaticResource RequiredStyle}">*</Label>
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="3" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.Phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="4" Grid.Column="0" Content="Факс:"/>
                    <Label Grid.Column="1" Grid.Row="4"  Style="{StaticResource RequiredStyle}">*</Label>
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="4" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.Fax, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="5" Grid.Column="0" Content="Электронная почта:"/>
                    <Label Grid.Column="1" Grid.Row="5"  Style="{StaticResource RequiredStyle}">*</Label>
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="5" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="6" Grid.Column="0" Content="Банк получателя:"/>
                    <Label Grid.Column="1" Grid.Row="6"  Style="{StaticResource RequiredStyle}">*</Label>
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="6" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.Bank, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="7" Grid.Column="0" Content="Расчётный счёт:"/>
                    <Label Grid.Column="1" Grid.Row="7"  Style="{StaticResource RequiredStyle}">*</Label>
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="7" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.CheckingAccount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>
            </Grid>
        </GroupBox>

        

            <!-- Руководство -->
            <GroupBox Header="Руководитель">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Style="{StaticResource InputInfoStyle}" Grid.Row="0" Grid.Column="0" Content="Должность руководителя:"/>
                    <Label Grid.Column="1" Grid.Row="0"  Style="{StaticResource RequiredStyle}">*</Label>
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="0" Grid.Column="2" 
                             Margin="5,2" 
                             Text="{Binding MainEntity.HeadPosition, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                    <Label Style="{StaticResource InputInfoStyle}" Grid.Row="1" Grid.Column="0" Content="Фамилия И.О. руководителя:"/>
                    <Label Grid.Column="1" Grid.Row="1"  Style="{StaticResource RequiredStyle}">*</Label>
                    <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="1" Grid.Column="2" 
                             Margin="5,2" 
                             Text="{Binding MainEntity.HeadFullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>
                </Grid>
            </GroupBox>
            
        </StackPanel>


        <!-- Банковские и регистрационные данные -->
        <GroupBox Header="Банковские и регистрационные реквизиты" 
                  Margin="0,0,0,10"
                  Grid.Column="1" Grid.Row="1"
                  Height="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="0" Grid.Column="0" Content="БИК:"/>
                <Label Grid.Column="1" Grid.Row="0"  Style="{StaticResource RequiredStyle}">*</Label>
                <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="0" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.Bik, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="1" Grid.Column="0" Content="ИНН:"/>
                <Label Grid.Column="1" Grid.Row="1"  Style="{StaticResource RequiredStyle}">*</Label>
                <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="1" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.Inn, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="2" Grid.Column="0" Content="ОГРН:"/>
                <Label Grid.Column="1" Grid.Row="2"  Style="{StaticResource RequiredStyle}">*</Label>
                <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="2" Grid.Column="3" Margin="5,2" Text="{Binding MainEntity.Ogrn, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="3" Grid.Column="0" Content="Свидетельство ЕГРЮЛ:"/>
                <Label Grid.Column="1" Grid.Row="3"  Style="{StaticResource RequiredStyle}">*</Label>
                <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="3" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.EgryulCertificate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="4" Grid.Column="0" Content="Выдано (МИФНС):"/>
                <Label Grid.Column="1" Grid.Row="4"  Style="{StaticResource RequiredStyle}">*</Label>
                <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="4" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.IssuedBy, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="5" Grid.Column="0" Content="Серия свидетельства:"/>
                <Label Grid.Column="1" Grid.Row="5"  Style="{StaticResource RequiredStyle}">*</Label>
                <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="5" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.CertificateSeries, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>

                <Label Style="{StaticResource InputInfoStyle}" Grid.Row="6" Grid.Column="0" Content="Номер свидетельства:"/>
                <Label Grid.Column="1" Grid.Row="6"  Style="{StaticResource RequiredStyle}">*</Label>
                <TextBox Style="{StaticResource InputTextBoxStyle}" Grid.Row="6" Grid.Column="2" Margin="5,2" Text="{Binding MainEntity.CertificateNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Validation.ErrorTemplate="{StaticResource ValidateTextBoxTemplate}"/>
            </Grid>
        </GroupBox>


        <StackPanel Grid.Column="0" Grid.Row="2"  Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Margin="10,10,10,10" Padding="10"
            MinWidth="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Command="{Binding SaveCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowButtonStyle}">
                Сохранить
            </Button>

            <Button Margin="10,10,10,10" Padding="10"
            MinWidth="120"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Command="{Binding CloseWindowCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{StaticResource WindowCloseButtonStyle}">
                Отмена
            </Button>
        </StackPanel>

    </Grid>
</Window>
